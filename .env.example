# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ── External APIs ────────────────────────────────────────────────
SEMRUSH_API_KEY=your_semrush_key_here
SERPAPI_API_KEY=your_serpapi_key_here
# 2026-06-01: multi-key rotation. Comma/semicolon-separated list of SerpAPI
# keys; the client auto-rotates to the next when one hits 429 ("run out of
# searches"). Lets you chain multiple free-tier accounts (100 searches each).
# When set, this takes precedence over SERPAPI_API_KEY. Per-key remaining
# searches are pre-flighted via SerpAPI's free /account endpoint at run
# start, and dead/exhausted keys are skipped before any sweep runs.
#   Example: SERPAPI_API_KEYS=keyA,keyB,keyC
SERPAPI_API_KEYS=
APOLLO_API_KEY=your_apollo_key_here
LUSHA_API_KEY=your_lusha_key_here
OPENAI_API_KEY=your_openai_key_here

# ── Google Places Intent Discovery (additive AU-only layer, 2026-05-18) ─
# Single key, no OAuth / developer tokens / customer IDs. Used by
# google_places_intent.GooglePlacesIntentDiscovery to find AU businesses
# via Places Text Search ("commercial plumber Sydney Australia" style
# queries). Leave blank to disable; existing SEMrush+SerpAPI+Apollo flow
# is unaffected. Get a key at https://console.cloud.google.com -> Places API.
GOOGLE_PLACES_API_KEY=

# Caps for the Places sweep — keep them low; each HTTPS round-trip eats
# a $ tier-bound quota unit and the goal of this layer is FREE-tier
# coverage. Tune higher only if you've enabled paid billing on the GCP
# project AND need wider coverage. AU-only, city-only targeting.
GOOGLE_INTENT_MAX_PLACES_CALLS=25
GOOGLE_INTENT_MAX_DOMAINS=100

# 2026-05-26: Paid-traffic gate on Places-discovered domains. Mirrors the
# V5 phase-4 `paid_traffic >= 5` filter at FETCH time so we don't burn
# Apollo credits on AU SMBs that don't actually run ads. Verifier =
# SEMrush domain_ranks (primary, uses your SEMrush quota) + SerpAPI
# ads-only branded query (fallback). Volume-floor backstop in the caller
# tops up unverified domains if the verified set is too thin to enrich.
GOOGLE_PLACES_PAID_MIN=5
GOOGLE_PLACES_VERIFY_MAX=30

# ── Google Ads Transparency Center verifier (2026-05-28) ───────────
# FREE, no key. Reverse-engineered internal endpoint (SearchSuggestions)
# that confirms which discovered AU businesses actually run Google ads —
# the PRIMARY paid-advertiser signal, working even when SEMrush/SerpAPI
# are out of balance. Catches small AU local advertisers that SEMrush/
# Ahrefs miss entirely. Set ATC_ENABLED=0 to disable. ATC_VERIFY_MAX caps
# lookups per run (free + fast, so default is generous).
ATC_ENABLED=1
ATC_VERIFY_MAX=120
SERP_ADS_MAX_QUERIES=80
# SerpApi engine for the ads-only sweep. "google_ads" = dedicated sponsored-
# results scraper (more advertisers/credit). Auto-falls-back to "google".
SERP_ADS_ENGINE=google_ads
# Min distinct ad-queries a domain must appear on to count as a HEAVY
# advertiser (the SEMrush/Ahrefs-trackable, paid>5 profile). Ranks heavy
# advertisers paid-first; with STRICT_PAID_ONLY=1 keeps ONLY these.
SERP_ADS_MIN_FREQ=2

# 2026-06-01: strict paid-only mode. When set to 1, drop all Google Places
# domains that don't pass paid verification (ATC/SEMrush/SerpAPI ads).
# No volume-floor backfill, no non-advertisers in the CSV. Use when you'd
# rather get FEWER leads than non-advertisers.
STRICT_PAID_ONLY=0

# ── Google Gemini API (Vertex AI semantic ranker, 2026-05-25) ──────
# Single key from https://aistudio.google.com/app/apikey (free tier:
# 1500 requests/day). Used by vertex_ai_ranker.py to rank all
# discovered domains by B2B buying intent BEFORE Apollo enrichment.
# Leave blank to disable.
GEMINI_API_KEY=
VERTEX_MAX_DOMAINS_PER_RANK=60

# ── Google Custom Search JSON API (2026-05-25) ─────────────────────
# Additive ORGANIC-results discovery layer. Free tier = 100 queries/day.
# Needs BOTH a Google Cloud key AND a Programmable Search Engine ID (cx)
# created at https://programmablesearchengine.google.com — configure the
# engine to "Search the entire web" so results aren't site-scoped.
# Used by google_custom_search.py inside city_pipeline._discover_domains
# as PASS 2.5 (between SerpAPI and SEMrush competitor expansion).
# Leave either blank to disable.
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
GOOGLE_CSE_MAX_QUERIES=10
GOOGLE_CSE_MAX_DOMAINS=80

# ── Phase 2: MySQL (Railway) ─────────────────────────────────────
# Railway provides both a private (internal) and a public (proxy) URL.
# Set MYSQL_URL for in-Railway deploys; use MYSQL_PUBLIC_URL for local dev.
# Discrete MYSQL* vars win over URL vars if all four are present.
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=railway
MYSQL_URL=
MYSQL_PUBLIC_URL=

# Fail-closed switch. Set to 1 to allow pipeline runs even when MySQL is down
# (CSV-only mode, no master dedup). Default 0 = refuse /generate if DB is unreachable.
ALLOW_RUN_WITHOUT_DB=0

# ── Phase 2: Auth / session ──────────────────────────────────────
# Random 32+ byte hex string. Required in production; dev boots with a warning.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cookies: set to 1 when serving over HTTPS (Railway) so session cookies
# only travel on encrypted connections.
SESSION_COOKIE_SECURE=0

# Optional: override the first-run users seeded when the users table is empty.
# Accepts a JSON list of {username,email,password,role}.
# Leaving blank uses the built-in admin_radius + lead_hunter_01..10 with random passwords.
SEED_USERS_JSON=

# ── Phase 2: Apollo phone-reveal webhook HMAC secret ─────────────
# If set, POSTs to /apollo-phone-callback must include
# X-LeadForge-Sig = HMAC-SHA256(secret, raw_body) hex. Leave blank to disable
# the check in development (NOT recommended in production).
APOLLO_WEBHOOK_SECRET=

# ── Phase 2: Competitor BFS tuning ───────────────────────────────
COMPETITOR_MAX_DEPTH=3
COMPETITOR_MAX_PER_DOMAIN=3
COMPETITOR_CALL_BUDGET=50

# ── Phase 2: Debug / escape hatches ──────────────────────────────
# Set to 1 to bypass the master-DB dedup filter in _phase6_export.
SKIP_MASTER_DEDUP=0
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
